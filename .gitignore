bin/
# `go build ./cmd/x` with no -o drops the binary in the working directory,
# which for a worktree is the repo root; git does not diff binaries, so one
# slips into a commit unseen by its own diffstat
/fakeclaude
/spool
.data/
web/node_modules/
# `make ui-shots` writes the standard screenshot set here: evidence to attach
# to a PR, never repo content — and a shot is only ever as fresh as the run
# that took it
web/shots/
# `make ui-smoke` leaves its Playwright trace here when the walk fails
web/smoke-trace.zip
web/dist/*
!web/dist/.gitkeep
*.tsbuildinfo
*.db
*.db-wal
*.db-shm
